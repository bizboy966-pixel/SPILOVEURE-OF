{
  "name": "@workspace/capacitor-android",
  "version": "1.1.17",
  "private": true,
  "scripts": {
    "prepare:web": "node prepare-web.cjs",
    "icons:generate": "bash ./generate-icon-assets.sh",
    "sync": "pnpm run prepare:web && cap sync android",
    "apk:debug": "pnpm run sync && cd android && ./gradlew :app:assembleDebug",
    "apk:release": "node ./release-official.cjs",
    "apk": "pnpm run apk:release",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "esbuild": "0.28.2"
  }
}
