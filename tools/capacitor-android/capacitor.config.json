{
  "appId": "com.spilivere.app",
  "appName": "SPILOVEURE",
  "webDir": "www",
  "server": {
    "hostname": "spiloveure.org",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "resolveServiceWorkerRequests": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorCookies": { "enabled": true }
  }
}
