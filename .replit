modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["jdk21", "android-tools"]

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19080
externalPort = 3000

[[ports]]
localPort = 20285
externalPort = 80
