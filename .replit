modules = ["python-3.12", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["mongodb-ce"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SPV_PREVIEW_MODE=isolated DB_NAME=spiloveure_local_development MONGO_URL=mongodb://127.0.0.1:27017 bash scripts/start-dev.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080
